{
  "pdf": {
    "format": "A4",
    "margin": {
      "top": "1in",
      "right": "1in",
      "bottom": "1in",
      "left": "1in"
    },
    "displayHeaderFooter": true,
    "headerTemplate": "<div style='font-size: 10px; text-align: center; width: 100%;'>Tavolo - Report</div>",
    "footerTemplate": "<div style='font-size: 10px; text-align: center; width: 100%;'><span class='pageNumber'></span> / <span class='totalPages'></span></div>",
    "printBackground": true,
    "landscape": false
  },
  "markdown": {
    "breaks": true,
    "linkify": true,
    "typographer": true
  },
  "css": {
    "github": true,
    "highlight": true
  },
  "encoding": "utf-8"
}
